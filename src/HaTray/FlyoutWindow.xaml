<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaTray.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HA Tray">
    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- 面板字体：Segoe UI Variable，中文回退微软雅黑。Grid 没有字体属性，用隐式样式给文字和按钮。 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MacButtonStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏由代码画：主界面是「房间名 ⇕」和星标，二级页是返回和标题。 -->
        <Grid x:Name="Header" Padding="10,10,10,4" MinHeight="46" />

        <!-- 断线时的提示条：数据还在，只是可能不是最新的。 -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,4" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- 留白放在 Body 上（见 Render），不放在滚动区上：滚动区把内容裁在内边距以内，编辑时伸出去的 − 和图钉会被裁掉。 -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
            <StackPanel x:Name="Body" />
        </ScrollViewer>

        <!-- 磁贴设置面板：编辑模式下点磁贴时从底部浮出来。 -->
        <Border x:Name="SheetHost" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" Margin="10" Visibility="Collapsed" />

        <StackPanel x:Name="Placeholder" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" Spacing="16">
            <ProgressRing x:Name="Loading" Width="28" Height="28" IsActive="False" />
            <TextBlock x:Name="PlaceholderText" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="PlaceholderButton" HorizontalAlignment="Center" Click="PlaceholderButton_Click" />
        </StackPanel>
    </Grid>
</Window>

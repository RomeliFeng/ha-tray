<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HaTray</RootNamespace>
    <AssemblyName>HaTray</AssemblyName>
    <Product>HA Tray</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HaTray.ico</ApplicationIcon>

    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>

    <UseWinUI>true</UseWinUI>
    <!-- 不打包，但依赖系统已安装的 Windows App Runtime，不把运行库复制进发布目录。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- 不打包的程序 dotnet publish 时也要生成 HaTray.pri 和 .xbf；不开这项，发布出来的程序一启动就因为找不到 FlyoutWindow.xaml 崩溃。 -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico;Assets\*.png;Assets\*.ttf;Assets\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      只引用 WinUI 这一个子包（它自己依赖 Foundation、InteractiveExperiences、Base）。
      完整的 Microsoft.WindowsAppSDK 会带上 AI、ML、搜索、小组件（onnxruntime、DirectML 等），本程序用不到，发布包会多出 100 MB 左右。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 要的 2.1.8 在 NuGet 上没有，写明用 2.1.9（不写也会解析成它，只是报 NU1603）。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>
</Project>
